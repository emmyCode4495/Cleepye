# ClipMine Configuration

# Server
HOST=127.0.0.1
PORT=8741
DEBUG=true

# Security (auto-generated on first run if empty)
SECRET_KEY=
ENCRYPTION_KEY=

# AI Scoring Provider
# Options: "local" (Ollama), "openrouter", "openai", "anthropic"
AI_PROVIDER=local

# BYOK Keys (only needed if AI_PROVIDER is not "local")
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (for local scoring)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b          # or llama3.1:8b, mistral, etc.

# Whisper
WHISPER_MODEL=medium             # tiny, base, small, medium, large-v3
WHISPER_DEVICE=auto              # auto, cpu, cuda
WHISPER_COMPUTE_TYPE=int8        # int8, float16, float32

# Paths
DATA_DIR=./data
STORAGE_DIR=./data/storage
DB_PATH=./data/clipmine.db

# Performance
MAX_CONCURRENT_JOBS=2
